<%- include("partials/header", { title: title }) %>

<section class="page-header">
  <h1>Edit Organization</h1>
  <p>Update the information for this organization.</p>
</section>

<section class="project-form">
  <form action="/edit-organization/<%= organization.organization_id %>" method="POST">

    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= organization.name %>"
        maxlength="150"
        required
      >
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        rows="5"
        maxlength="500"
        required
      ><%= organization.description %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        value="<%= organization.contact_email %>"
        required
      >
    </div>

    <div class="form-group">
      <label for="logoFilename">Logo Filename</label>
      <input
        type="text"
        id="logoFilename"
        name="logoFilename"
        value="<%= organization.logo_filename %>"
      >
    </div>

    <div class="form-actions">
      <button type="submit">Update Organization</button>
      <a href="/organization/<%= organization.organization_id %>">Cancel</a>
    </div>

  </form>
</section>

<%- include("partials/footer") %>