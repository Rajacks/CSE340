<%- include('partials/header', { title: title }) %>

<section class="page-header organization-header">

  <div class="organization-logo-container">
    <img
      class="organization-logo"
      src="/images/<%= organization.logo_filename %>"
      alt="<%= organization.name %> logo"
    >
  </div>

  <div class="organization-info">
    <h1><%= organization.name %></h1>

    <p>
      <%= organization.description %>
    </p>
  </div>

  <div class="organization-header-space"></div>

</section>

<section class="organization-details">
  <p>
    <strong>Contact Email:</strong>
    <%= organization.contact_email %>
  </p>

  <p>
    <strong>Organization ID:</strong>
    <%= organization.organization_id %>
  </p>
</section>

<section class="project-list">
  <h2>Service Projects</h2>

  <% projects.forEach(project => { %>
    <article>
      <h3>
        <a href="/project/<%= project.project_id %>">
          <%= project.title %>
        </a>
      </h3>

      <p><%= project.description %></p>

      <p>
        <strong>Location:</strong>
        <%= project.location %>
      </p>

      <p>
        <strong>Date:</strong>
        <%= new Date(project.project_date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        }) %>
      </p>
    </article>
  <% }) %>
</section>

<section>
  <p>
    <a href="/edit-organization/<%= organization.organization_id %>">
      Edit Organization
    </a>
  </p>
  <p><a href="/projects">View Upcoming Projects</a></p>
  <p><a href="/organizations">Back to Organizations</a></p>
</section>

<%- include('partials/footer') %>