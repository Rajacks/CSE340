
<%- include("partials/header") %>

<h1><%= title %></h1>

<p>Welcome to your dashboard, <%= user.name %>!</p>

<!-- Week 6: My Volunteer Projects -->
<section class="volunteer-projects">
  <h2>My Volunteer Projects</h2>

  <% if (volunteerProjects && volunteerProjects.length > 0) { %>
    <p>Here are the projects you have signed up to volunteer for.</p>

    <% volunteerProjects.forEach(project => { %>
      <article class="volunteer-project">
        <h3>
          <a href="/project/<%= project.project_id %>">
            <%= project.title %>
          </a>
        </h3>

        <p>
          <strong>Organization:</strong>
          <%= project.organization_name %>
        </p>

        <p>
          <strong>Date:</strong>
          <%= new Date(project.project_date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric"
          }) %>
        </p>

        <p>
          <strong>Location:</strong>
          <%= project.location %>
        </p>

        <form
          method="POST"
          action="/project/<%= project.project_id %>/remove-volunteer"
        >
          <button type="submit">
            Remove My Volunteer Signup
          </button>
        </form>

        <hr>
      </article>
    <% }) %>

  <% } else { %>
    <p>You haven't signed up to volunteer for any projects yet.</p>
    <p>
      <a href="/projects">Browse Upcoming Projects</a>
      to find a project you would like to support.
    </p>
  <% } %>
</section>
<!-- End Week 6: My Volunteer Projects -->

<% if (user.role_id === 2) { %>
  <h2>Admin Options</h2>

  <ul>
    <li>
      <a href="/users">View All Users</a>
    </li>
  </ul>
<% } %>

<%- include("partials/footer") %>
