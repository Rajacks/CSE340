```ejs
<%- include('partials/header', { title: title }) %>

<section class="page-header">
  <h1><%= project.title %></h1>
  <p>
    <strong>Organization:</strong>
    <a href="/organization/<%= project.organization_id %>">
      <%= project.organization_name %>
    </a>
  </p>
</section>

<section class="project-details">
  <p>
    <strong>Date:</strong>
    <%= new Date(project.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    }) %>
  </p>

  <p>
    <strong>Location:</strong>
    <%= project.location %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= project.description %>
  </p>

  <div class="category-tags">
    <strong>Categories:</strong>

    <% categories.forEach(category => { %>
      <a href="/category/<%= category.category_id %>">
        <%= category.name %>
      </a>
    <% }) %>
  </div>

  <!-- Week 6: Project Volunteering -->
  <% if (user) { %>
    <section class="volunteer-section">
      <h2>Volunteer for This Project</h2>

      <% if (isVolunteer) { %>
        <p>You are currently volunteering for this project.</p>

        <form
          method="POST"
          action="/project/<%= project.project_id %>/remove-volunteer"
        >
          <button type="submit">
            Remove My Volunteer Signup
          </button>
        </form>
      <% } else { %>
        <p>Interested in helping with this project?</p>

        <form
          method="POST"
          action="/project/<%= project.project_id %>/volunteer"
        >
          <button type="submit">
            Volunteer for This Project
          </button>
        </form>
      <% } %>
    </section>
  <% } %>
  <!-- End Week 6: Project Volunteering -->

  <% if (user && user.role_id === 2) { %>
    <p>
      <a href="/edit-project/<%= project.project_id %>">
        Edit Project
      </a>
    </p>

    <p>
      <a href="/assign-categories/<%= project.project_id %>">
        Assign Categories
      </a>
    </p>
  <% } %>

  <p>
    <a href="/projects">Back to Upcoming Projects</a>
  </p>
</section>

<%- include('partials/footer') %>
```