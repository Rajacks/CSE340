<%- include('partials/header', { title: title }) %>

<section class="page-header">
  <h1>Assign Categories</h1>
  <p>
    Choose the categories that apply to
    <strong><%= project.title %></strong>.
  </p>
</section>

<section class="project-form">
  <form
    action="/assign-categories/<%= project.project_id %>"
    method="POST"
  >

    <% categories.forEach(category => { %>
      <div class="form-group">
        <label>
          <input
            type="checkbox"
            name="categoryIds"
            value="<%= category.category_id %>"
            <%= assignedCategoryIds.includes(category.category_id) ? "checked" : "" %>
          >
          <%= category.name %>
        </label>
      </div>
    <% }) %>

    <div class="form-actions">
      <button type="submit">Save Categories</button>

      <a href="/project/<%= project.project_id %>">
        Cancel
      </a>
    </div>

  </form>
</section>

<%- include('partials/footer') %>